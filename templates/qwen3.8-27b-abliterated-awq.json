      "NVIDIA RTX 6000 Ada Generation",
      "NVIDIA L40",
      "NVIDIA L40S"
    ],
    "workersMin": 0,
    "workersMax": 1,
    "idleTimeout": 5,
    "executionTimeoutMs": 600000,
    "flashboot": true,
    "networkVolume": {
      "sizeGb": 30,
